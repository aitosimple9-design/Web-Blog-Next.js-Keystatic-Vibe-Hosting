{
  "permissions": {
    "allow": [
      "Bash(npm run dev)",
      "Bash(npm run lint)",
      "Bash(npm run build)",
      "Bash(git status)",
      "Bash(git diff *)",
      "Bash(git log *)",
      "Bash(git branch *)",
      "Bash(git switch *)",
      "Bash(git add *)",
      "Bash(git commit *)",
      "Bash(gh issue view *)",
      "Bash(gh issue list *)",
      "Bash(gh pr view *)",
      "Bash(gh pr list *)",
      "Bash(gh pr checks *)",
      "Bash(gh run view *)",
      "Bash(gh run list *)"
    ],
    "deny": [
      "Bash(gh pr merge *)",
      "Bash(gh repo delete *)",
      "Bash(gh secret *)",
      "Bash(gh variable *)",
      "Bash(git push --force *)",
      "Bash(git push -f *)",
      "Bash(git push origin main*)",
      "Bash(git reset --hard *)",
      "mcp__github__merge_pull_request",
      "mcp__github__push_files",
      "mcp__github__create_or_update_file",
      "mcp__github__delete_file"
    ],
    "ask": [
      "Edit(**/.env*)",
      "Write(**/.env*)",
      "Edit(./.github/workflows/**)",
      "Write(./.github/workflows/**)",
      "Bash(npm install *)",
      "Bash(npm i *)",
      "Bash(npm uninstall *)",
      "Bash(pnpm add *)",
      "Bash(pnpm remove *)",
      "Bash(npx *)",
      "Bash(git push *)",
      "Bash(gh pr create *)",
      "Bash(gh issue create *)",
      "Bash(rm *)"
    ]
  },
  "enabledPlugins": {
    "superpowers@anthropic-plugin-directory": true,
    "frontend-design@anthropic-plugin-directory": true,
    "code-review@anthropic-plugin-directory": true,
    "feature-dev@anthropic-plugin-directory": true,
    "commit-commands@anthropic-plugin-directory": true
  },
  "autoMode": {
    "soft_deny": [
      "$defaults",
      "Bash(git push:*) direct to main — CLAUDE.md §10 requires feature branches and PRs, never direct commits to main",
      "Edit/Write on content/posts/* existing files without explicit instruction — CLAUDE.md §12 forbids modifying or deleting existing post files unless explicitly requested",
      "Edit/Write on .env* files — CLAUDE.md §12 and §8 forbid editing .env* or committing secrets"
    ]
  }
}
