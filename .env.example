# App runtime secrets (Next.js / Keystatic). Copy to .env.local. Never commit .env.local.
# Keystatic: "local" (mặc định, dev) hoặc "github" (production, cần 4 biến GitHub App bên dưới)
NEXT_PUBLIC_KEYSTATIC_STORAGE=local
# Keystatic tự ghi 4 biến này vào .env khi tạo GitHub App ở /keystatic (chế độ github):
# KEYSTATIC_GITHUB_CLIENT_ID=
# KEYSTATIC_GITHUB_CLIENT_SECRET=
# KEYSTATIC_SECRET=
# NEXT_PUBLIC_KEYSTATIC_GITHUB_APP_SLUG=

# ---------------------------------------------------------------------------
# MCP / Claude Code keys do NOT go here. Claude Code does not read .env.local.
# Put them in .claude/settings.local.json (gitignored) under "env":
#
#   {
#     "env": {
#       "CONTEXT7_API_KEY": "...",             # https://context7.com/dashboard
#       "GITHUB_PERSONAL_ACCESS_TOKEN": "..."  # fine-grained PAT, used by .mcp.json
#     }
#   }
# ---------------------------------------------------------------------------

# Địa chỉ chính thức của web (sitemap, canonical, ảnh chia sẻ, JSON-LD). Không có dấu / ở cuối.
# Máy cá nhân: http://localhost:3000. Production: đặt trên Vercel (Settings > Environment Variables) bằng tên miền thật, vd. https://tenmien.com
# Thiếu biến này thì mặc định localhost:3000 và sitemap trỏ sai địa chỉ.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
